# Django Configuration
DJANGO_SECRET_KEY=your-django-secret-key
DEBUG=True
DEVELOPMENT_MODE=True

# JWT Configuration (Minutes)
JWT_ACCESS_LIFETIME_MINUTES=60

# Database Configuration (Development Mode - Optional: 若未配置將自動備援回退至本機 SQLite)
PostgreSQL_NAME=keyworddb
PostgreSQL_USER=postgres
PostgreSQL_PASSWORD=postgres
PostgreSQL_HOST=localhost
PostgreSQL_PORT=5432

# Production Database (Render / Heroku / Supabase)
DATABASE_URL=postgresql://user:password@host:port/dbname

# React Frontend (.env for keyword_analysis_reactapp)
REACT_APP_APP_URL=http://127.0.0.1:8000
